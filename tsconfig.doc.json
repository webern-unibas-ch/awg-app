{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./out-tsc/app",
        "types": ["node"],
        "paths": {
            "@awg-app/*": ["./src/app/*"],
            "@awg-core/*": ["./src/app/core/*"],
            "@awg-shared/*": ["./src/app/shared/*"],
            "@awg-views/*": ["./src/app/views/*"],
            "@awg-graph/*": ["./src/app/views/edition-view/edition-outlets/edition-complex/edition-detail/edition-graph/*"],
            "@awg-report/*": ["./src/app/views/edition-view/edition-outlets/edition-complex/edition-detail/edition-report/*"],
            "assets/*": ["./src/assets/*"],
            "environments/*": ["./src/environments/*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/test.ts", "src/**/*.spec.ts", "src/testing/*"]
}
