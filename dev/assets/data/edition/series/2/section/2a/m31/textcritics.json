        {
            "id": "M31_TF1",
            "label": "M 31 einzige Textfassung",
            "evaluations": [
                "Für die Textedition der Studienkomposition für Klavier M 31 ist <a (click)=\"ref.navigateToReportFragment({complexId: 'm31', fragmentId: 'source_B'})\"><strong>B</strong></a> relevante Quelle. <a (click)=\"ref.navigateToReportFragment({complexId: 'm31', fragmentId: 'source_A'})\"><strong>A</strong></a> enthält Skizzen.",
                "<a (click)=\"ref.navigateToReportFragment({complexId: 'm31', fragmentId: 'source_B'})\"><strong>B</strong></a> weist zwei unterscheidbare Korrekturschichten auf: Korrekturen 1 mit Tinte sowie die später entstandenen Korrekturen 2 mit Bleistift. Der Zustand vor Korrekturen 1 ist nicht immer zu entziffern.",
                "Hauptquelle für die Textedition der Studienkomposition für Klavier M 31 ist <a (click)=\"ref.navigateToReportFragment({complexId: 'm31', fragmentId: 'source_B'})\"><strong>B</strong></a> nach Korrekturen 1."
