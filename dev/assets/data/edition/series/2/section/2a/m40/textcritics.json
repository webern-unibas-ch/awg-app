        {
            "id": "M40_TF1",
            "label": "M 40 einzige Textfassung",
            "evaluations": [
                "Für die Textedition der Studienkomposition für Klavier M 40 ist <a data-complex-id='m40' data-report-fragment-id='source_B'><strong>B</strong></a> relevante Quelle. <a data-complex-id='m40' data-report-fragment-id='source_A'><strong>A</strong></a> enthält Skizzen.",
                "<a data-complex-id='m40' data-report-fragment-id='source_B'><strong>B</strong></a> weist zwei unterscheidbare Korrekturschichten auf: Korrekturen 1 mit Tinte sowie die später entstandenen Korrekturen 2 mit Bleistift. Der Zustand vor Korrekturen 1 ist nicht immer zu entziffern.",
                "Hauptquelle für die Textedition der Studienkomposition für Klavier M 40 ist <a data-complex-id='m40' data-report-fragment-id='source_B'><strong>B</strong></a> nach Korrekturen 1."
            ],
