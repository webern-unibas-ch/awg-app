{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node"],
        // Unchecked as in tsconfig.spec.json (the app code is linted via tsconfig.app.json)
        "noUncheckedIndexedAccess": false
    },
    "include": ["src/**/*.spec.ts", "src/test.ts", "src/testing/**/*.ts", "src/**/*.d.ts", "vitest-base.config.ts"]
}
