{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node"],
        // Used for the specs and testing helpers (not part of app and doc), so unchecked as in tsconfig.spec.json
        "noUncheckedIndexedAccess": false
    },
    "include": [
        "src/app/**/*.ts",
        "src/environments/**/*.ts",
        "src/main.ts",
        "src/polyfills.ts",
        "src/test.ts",
        "src/testing/**/*.ts",
        "src/**/*.d.ts",
        "vitest-base.config.ts"
    ]
}
