    "description": "A web application for the Online Edition of the Anton Webern Gesamtausgabe (Musicological Seminar of the University of Basel)",
    "keywords": [
        "angular",
        "anton-webern",
        "digital-musicology",
        "digital-music-edition",
        "digital-humanities",
        "edition"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/webern-unibas-ch/awg-app.git"
    },
    "homepage": "https://edition.anton-webern.ch",
    "bugs": "",
    "private": true,
    "scripts": {
        "husky:prepare": "husky",
        "ng": "ng",
        "start": "ng serve",
        "-- TEST --": "",
        "test": "ng test",
        "test:local": "ng test --browsers=chromium",
        "test:cov": "ng test --coverage --no-watch",
        "test:cov:serve": "yarn test:cov && yarn dlx http-server -c-1 -o -p 9875 ./coverage",
        "test:ci": "yarn test:cov",
        "-- LINT --": "",
        "lint": "ng lint awg-app",
        "lint:fix": "yarn lint --fix",
        "lint-files": "eslint",
        "lint-files:fix": "yarn lint-files --fix",
        "lint-staged": "lint-staged",
        "format-files:check": "prettier --check \"src/**/*.{ts,js,html,css,scss}\"",
        "format-files:fix": "prettier --write \"src/**/*.{ts,js,html,css,scss}\"",
        "-- DOCS --": "",
        "doc": "compodoc --tsconfig tsconfig.doc.json --theme Readthedocs --output dist/awg-app/compodoc",
        "doc:build": "yarn doc",
        "doc:serve": "yarn doc --serve --watch",
        "-- BUILD --": "",
        "build:prod": "ng build",
        "build:watch": "ng build --watch --configuration development",
        "build:attach": "yarn compress:dist && yarn doc:build",
        "build:gh": "yarn build:prod --base-href https://edition.anton-webern.ch && yarn build:attach",
        "build:dev": "yarn build:prod --base-href https://edition.anton-webern.ch/dev/ && yarn build:attach",
        "compress:dist": "gzipper compress ./dist/awg-app/ --gzip --brotli",
        "-- ANALYZE --": "",
        "analyze": "yarn build:prod --stats-json",
        "analyze:local": "yarn analyze && esbuild-visualizer --metadata dist/awg-app/browser-stats.json --filename dist/awg-app/browser-stats.html --title \"AWG App Bundle\" --open",
        "-- CHECK --": "",
        "check:complexes": "node scripts/check-complexes.js",
        "check:cycles": "madge --circular --extensions ts --ts-config tsconfig.json src",
        "check:glyphs": "node scripts/check-glyphs.js",
        "check:snippets": "node scripts/check-snippets.js",
        "check:sources": "node scripts/check-shared-sources.js",
        "-- DEPLOY --": "",
        "pre-release": "commit-and-tag-version -a",
        "update-appversion": "sh ./version.sh",
        "deploy:ci": "ng deploy --no-build --message=\"Release $npm_package_name (v$npm_package_version) on gh-pages\""
    },
    "dependencies": {
        "@angular/common": "^22.2.3",
        "@angular/compiler": "^22.2.3",
        "@angular/core": "^22.2.3",
        "@angular/forms": "^22.2.3",
        "@angular/localize": "^22.2.3",
        "@angular/platform-browser": "^22.2.3",
        "@angular/router": "^22.2.3",
        "@codemirror/language": "^6.13.1",
        "@codemirror/legacy-modes": "^6.5.5",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.14",
        "@fortawesome/angular-fontawesome": "^5.1.0",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@ng-bootstrap/ng-bootstrap": "^21.0.0",
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8",
        "codemirror": "^6.0.2",
        "d3-drag": "^3.0.0",
        "d3-fetch": "^3.0.1",
        "d3-force": "^3.0.0",
        "d3-selection": "^3.0.0",
        "d3-zoom": "^3.0.0",
        "n3": "^2.13.12",
        "ngx-json-viewer": "^3.2.1",
        "rdfstore": "webern-unibas-ch/rdfstore-js#v0.9.18-alpha.24",
        "rxjs": "~7.8.2",
        "stream": "^0.0.3",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular/build": "^22.2.4",
        "@angular/cli": "^22.2.4",
        "@angular/compiler-cli": "^22.2.3",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-angular": "^21.2.4",
        "@compodoc/compodoc": "^2.0.0",
        "@eslint/js": "^10.0.1",
        "@rdfjs/types": "^2.0.1",
        "@types/d3": "^7.4.3",
        "@types/n3": "^1.26.5",
        "@types/node": "^26.6.5",
        "@vitest/browser-playwright": "^5.0.5",
        "@vitest/coverage-v8": "^5.0.5",
        "angular-cli-ghpages": "^3.1.2",
        "angular-eslint": "^22.6.0",
        "commit-and-tag-version": "^13.3.0",
        "conventional-recommended-bump": "^12.1.0",
        "esbuild-visualizer": "^0.7.0",
        "eslint": "^10.13.0",
        "eslint-plugin-jsdoc": "^65.4.2",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.13.0",
        "gzipper": "^8.3.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "madge": "^8.0.0",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": "^22.23.4 || >= 24.22.1",
        "npm": ">= 10.9.8",
        "yarn": "^4.16.0"
    },
    "packageManager": "yarn@4.16.0"
}
