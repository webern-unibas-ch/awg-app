{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./out-tsc/spec",
        "types": ["node"],
        "paths": {
            "@awg-app/*": ["./src/app/*"],
            "@awg-core/*": ["./src/app/core/*"],
            "@awg-shared/*": ["./src/app/shared/*"],
            "@awg-views/*": ["./src/app/views/*"],
            "@awg-graph/*": [
                "./src/app/views/edition-view/edition-outlets/edition-complex/edition-detail/edition-graph/*"
            ],
            "@awg-report/*": [
                "./src/app/views/edition-view/edition-outlets/edition-complex/edition-detail/edition-report/*"
            ],
            "assets/*": ["./src/assets/*"],
            "environments/*": ["./src/environments/*"],
            "@testing/*": ["./src/testing/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "src/testing/", "polyfills.ts"]
}
