{
    "textcritics": [
        {
            "id": "M35_42_TF1",
            "label": "M 35/42 einzige Textfassung",
            "evaluations": [
                "Für die Textedition der Studienkomposition für Klavier M 35/42 sind <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_B'})\"><strong>B</strong></a> und <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_D'})\"><strong>D</strong></a> relevante Quellen. <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_A'})\"><strong>A</strong></a> und <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_C'})\"><strong>C</strong></a> enthalten Skizzen.",
                "<a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_B'})\"><strong>B</strong></a> weist zwei unterscheidbare Korrekturschichten auf: <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_B_corr_1'})\">Korrekturen 1</a> mit Tinte sowie die später entstandenen <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_B_corr_2'})\">Korrekturen 2</a> mit Bleistift. <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_D'})\"><strong>D</strong></a> weist eine <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_D_corr'})\">Korrekturschicht mit Tinte</a> auf. Der Zustand vor Korrekturen 1 ist nicht immer zu entziffern. Die Tintenniederschrift in <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_D'})\"><strong>D</strong></a> stellt die Fortsetzung (ab T. 10) der früher entstandenen Tintenniederschrift in <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_B'})\"><strong>B</strong></a> dar und komplettiert mit dem kontrastierenden B-Teil sowie dem wiederkehrenden A-Teil das in <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_B'})\"><strong>B</strong></a> vorgestellte Thema zur dreiteiligen ABAʼ-Form.",
                "Hauptquellen für die Textedition der Studienkomposition für Klavier M 35/42 sind <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_B'})\"><strong>B</strong></a> nach Korrekturen 1 und <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_D'})\"><strong>D</strong></a> post correcturam."
            ],
            "commentary": {
                "preamble": "",
                "comments": [
                    {
                        "blockHeader": "",
                        "blockComments": [
                            {
                                "svgGroupId": "g-tkk-m35_42_tf1-1",
                                "measure": "23 <br />bis 24",
                                "system": "Klav. o.",
                                "position": "3/4 <br />1. Note",
                                "comment": "Ligatur zu T. 23 3/4 ergänzt. <a (click)=\"ref.navigateToReportFragment({complexId: 'm35_42', fragmentId: 'source_D'})\"><strong>D</strong></a>: Seitenwechsel nach T. 23."
                            },
                            {
                                "svgGroupId": "g-tkk-m35_42_tf1-2",
                                "measure": "25",
                                "system": "Klav. u.",
                                "position": "1. Note",
                                "comment": "Ces<sub>1</sub>/Es korrigiert zu Es<sub>1</sub>/Es mit Blick auf harmonischen Kontext."
                            },
                            {
                                "svgGroupId": "g-tkk-m35_42_tf1-3",
